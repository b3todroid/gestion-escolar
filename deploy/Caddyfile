# Gestión Escolar — proxy inverso con HTTPS (Fase 11).
# Sirve la PWA compilada y reenvía /api/* al servidor por la red privada de los contenedores.
# Variables (deploy/.env):
#   DOMINIO      nombre público, p. ej. gestion.escuela.edu.mx (preproducción local: localhost)
#   TLS          correo para Let's Encrypt (producción) o «internal» (certificado propio de Caddy, sólo pruebas)
{
	# La API de administración de Caddy queda apagada: nada administrativo se expone.
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$DOMINIO:localhost} {
	tls {$TLS:internal}
	import /etc/caddy/sitio.caddy
}
