# PREPRODUCCIÓN local con datos FICTICIOS (Fase 11). Copia como deploy/preproduccion.env.
MODO=preproduccion
DOMINIO=localhost
# Con un puerto distinto de 443, el origen público lleva el puerto
URL_PUBLICA=https://localhost:8443
TLS=internal
VERSION=0.1.0-preprod
GESTION_BD=gestion_piloto_preprod
GESTION_USUARIO=gestion
# Buzón SMTP de prueba (Mailpit) en la red interna: los correos se ven en http://127.0.0.1:8025
SMTP_HOST=correo-prueba
SMTP_PUERTO=1025
SMTP_SEGURIDAD=ninguna
SMTP_USUARIO=
SMTP_CLAVE_FILE=
SMTP_REMITENTE="Gestión Escolar PREPRODUCCIÓN <no-responder@preproduccion.local>"
PUERTO_HTTP=8080
PUERTO_HTTPS=8443
PUERTO_BUZON=8025
REGISTRO=docker.io/library
REGISTRO_EXTRA=docker.io
ESCALA_DEMO=0.2
RESPALDO_DESTINATARIO=
RESPALDO_DIR=./respaldos
RESPALDO_RETENER_DIAS=7
# Las pruebas automatizadas entran varias veces con la misma cuenta en pocos minutos.
# Producción usa el valor por omisión (3 códigos por correo cada 10 minutos).
LIMITE_CODIGOS_POR_CORREO=20
