# Gestión Escolar — variables del despliegue (Fase 11). Copia como deploy/.env (excluido de git).
# Este archivo NO lleva secretos: las contraseñas se generan en deploy/secretos/ con
# deploy/scripts/generar-secretos.sh y se montan como archivos de sólo lectura.

# produccion | preproduccion  (producción exige HTTPS, SMTP cifrado y una base que no sea de pruebas)
MODO=produccion
# Nombre público (requiere un dominio registrado y su DNS apuntando al servidor; PENDIENTE de autorización)
DOMINIO=gestion.escuela.example
# Certificado: correo para Let's Encrypt (renovación automática). «internal» SÓLO para pruebas locales.
TLS=ti@escuela.example
# Versión desplegada (etiqueta de las imágenes y versión visible en #/aplicacion)
VERSION=0.1.0
# Base de datos de ESTE entorno (producción nunca usa nombres con dev/prueba/piloto/demo/preprod)
GESTION_BD=gestion_produccion
GESTION_USUARIO=gestion

# Correo institucional (SMTP). La clave va en deploy/secretos/smtp_clave y se activa con SMTP_CLAVE_FILE.
SMTP_HOST=smtp.escuela.example
SMTP_PUERTO=587
# tls (465) | starttls (587)
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=no-responder@escuela.example
SMTP_CLAVE_FILE=/run/secrets/smtp_clave
SMTP_REMITENTE="Gestión Escolar <no-responder@escuela.example>"

ZONA_HORARIA=America/Mexico_City
SESION_HORAS=72
# Imágenes base (docker.io/library por omisión; un espejo si Docker Hub limita las descargas)
REGISTRO=docker.io/library

# Respaldos (deploy/scripts/respaldar.sh)
# Clave PÚBLICA de age: el servidor cifra, pero NO puede descifrar (la clave privada vive fuera del servidor).
RESPALDO_DESTINATARIO=age1reemplaza_por_la_clave_publica
RESPALDO_DIR=/var/respaldos/gestion-escolar
RESPALDO_RETENER_DIAS=35
