{
  "name": "gestion-escolar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA local-first para la gestión escolar (Fase 1: configuración escolar)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p servidor && tsc --noEmit -p servidor/pruebas",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "servidor": "npm run servidor:compilar && node --env-file-if-exists=servidor/.env dist-servidor/principal.mjs",
    "servidor:cli": "npm run servidor:compilar --silent && node --env-file-if-exists=servidor/.env dist-servidor/cli.mjs",
    "test:servidor": "npm run servidor:compilar --silent && vitest run --config servidor/vitest.config.ts",
    "test:e2e:servidor": "playwright test -c playwright.servidor.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "servidor:compilar": "vite build -c servidor/vite.config.ts",
    "test:rendimiento": "playwright test -c playwright.rendimiento.config.ts",
    "test:ux": "playwright test -c playwright.ux.config.ts",
    "piloto": "npm run servidor:compilar --silent && node --env-file-if-exists=servidor/.env dist-servidor/piloto.mjs",
    "piloto:app": "npm run build && npx vite preview --port 4180 --strictPort",
    "test:piloto": "playwright test -c playwright.piloto.config.ts",
    "test:piloto:multiusuario": "playwright test -c playwright.piloto-servidor.config.ts",
    "test:piloto:rendimiento": "playwright test -c playwright.piloto-rendimiento.config.ts",
    "test:despliegue": "playwright test -c playwright.despliegue.config.ts",
    "servidor:demo": "npm run servidor:compilar --silent && node --env-file-if-exists=servidor/.env dist-servidor/demo.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tesseract.js-data/spa": "1.0.0",
    "better-auth": "1.7.11",
    "dexie": "^4.4.7",
    "nodemailer": "10.1.7",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "fake-indexeddb": "^6.2.7",
    "oauth2-mock-server": "9.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
