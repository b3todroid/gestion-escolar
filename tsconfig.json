{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "piloto", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.rendimiento.config.ts", "playwright.ux.config.ts", "playwright.piloto.config.ts", "playwright.piloto-servidor.config.ts", "playwright.piloto-rendimiento.config.ts", "playwright.despliegue.config.ts", "playwright.manual.config.ts", "playwright.manual-servidor.config.ts"]
}
