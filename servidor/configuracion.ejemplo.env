# Configuración del servidor escolar (Fase 8B · SÓLO desarrollo local con datos ficticios).
# Copia este archivo como servidor/.env (está excluido de git) y ajusta los valores.
# Nunca subas servidor/.env ni pongas estos valores en el código de la aplicación.

MODO=desarrollo
# PostgreSQL local (usuario y base creados sólo para desarrollo)
DATABASE_URL=postgres://gestion_dev:CAMBIA_ESTA_CLAVE@localhost:5432/gestion_dev
# Secreto aleatorio de al menos 32 caracteres. Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Origen de la aplicación (el servidor de desarrollo de Vite reenvía /api a este servidor)
URL_PUBLICA=http://localhost:5173
PUERTO=8787
# 'buzon': los códigos no salen por correo; se consultan en /api/desarrollo/buzon?correo=… (sólo desde este equipo)
CORREO_MODO=buzon

# Cuentas institucionales (opcional; requieren registrar la aplicación con el proveedor)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DOMINIO=escuela.edu.mx
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
